# Copy to .env.dev in the repo root. Do not commit .env.dev.
APP_ENV=dev
COMPOSE_PROJECT_NAME=pid-dev

POSTGRES_USER=pid_user
POSTGRES_PASSWORD=pid_dev_password
POSTGRES_DB=pid_db

PORT=3010
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176
JWT_SECRET=dev-only-change-me

# Downstream Hub SSO. Leave SSO_OIDC_ENABLED unset until a Hub client id is available.
# SSO_TOKEN_SECRET must match the Hub. Do not commit a real secret.
APP_PUBLIC_ORIGIN=http://localhost:5176
SSO_TOKEN_SECRET=
SSO_LEGACY_BRIDGE_ENABLED=true
SSO_OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:4000
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:5176/auth/oidc/callback
OIDC_SCOPES=openid profile email

# The local admin (admin / admin123, all pages, Bekasi) is inserted by the seed
# only when APP_ENV=dev. Staging and production do not receive that account.

LOGSHEET_BASE=https://logsheet-builder.gamasap.com
LOGSHEET_IDENTIFIER=
LOGSHEET_PASSWORD=
