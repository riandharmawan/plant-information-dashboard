# Copy to Backend/.env on the API server. Do not commit Backend/.env.
APP_ENV=testing
COMPOSE_PROJECT_NAME=pid-staging

NODE_ENV=production
PORT=3010

DB_HOST=pgm-example.pgsql.ap-southeast-5.rds.aliyuncs.com
DB_PORT=5432
POSTGRES_USER=pid_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pid_db

# Optional: set full URL when POSTGRES_PASSWORD contains #, @, or other URL-reserved characters.
# DATABASE_URL=postgresql://pid_user:encoded%23password@pgm-example...:5432/pid_db

JWT_SECRET=change-me-strong-random
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://203.0.113.10:3090,http://172.28.92.56:3090
COOKIE_SECURE=false

LOGSHEET_BASE=https://logsheet-builder.gamasap.com
LOGSHEET_IDENTIFIER=
LOGSHEET_PASSWORD=
