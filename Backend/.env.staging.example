# Copy to Backend/.env on the API server. Do not commit Backend/.env.
APP_ENV=testing
COMPOSE_PROJECT_NAME=pid-staging

NODE_ENV=production
# Listen port inside the container. Do not change.
PORT=3010
# Host publish port on the shared API ECS (3010 is project_management_backend_staging).
PID_API_PORT=3011

DB_HOST=pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com
DB_PORT=5432
POSTGRES_USER=pid_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pid_db

# Optional: set full URL when POSTGRES_PASSWORD contains #, @, or other URL-reserved characters.
# DATABASE_URL=postgresql://pid_user:encoded%23password@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/pid_db

JWT_SECRET=change-me-strong-random
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://172.28.92.56:3091
COOKIE_SECURE=false

# Downstream Hub SSO. Obtain SSO_TOKEN_SECRET and OIDC_CLIENT_ID from the Hub operator.
# Do not commit real values. Leave SSO_OIDC_ENABLED unset until Hub has registered this app.
APP_PUBLIC_ORIGIN=http://172.28.92.56:3091
SSO_TOKEN_SECRET=
SSO_LEGACY_BRIDGE_ENABLED=true
SSO_OIDC_ENABLED=false
OIDC_ISSUER=http://172.28.92.56:3010
OIDC_DISCOVERY_URL=http://172.28.92.56:3010/api/sso/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://172.28.92.56:3091/auth/oidc/callback
OIDC_SCOPES=openid profile email

LOGSHEET_BASE=https://logsheet-builder.gamasap.com
LOGSHEET_IDENTIFIER=
LOGSHEET_PASSWORD=
